	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = glibc
	depends = gcc-libs
	optdepends = gst-plugin-pipewire: record voice memos from PipeWire microphones
	optdepends = ffmpeg: transcribe voice memos with services that only read WAV
	options = !lto
	source = gnotes-gtk-1.5.0.tar.gz::https://github.com/justinmdickey/gnotes/archive/refs/tags/v1.5.0.tar.gz
